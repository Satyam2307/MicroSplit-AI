# MicroSplit AI – Environment Variables
# Copy to .env and fill in real values

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/microsplit

# ─── PayPal Sandbox ───────────────────────────────────────
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_webhook_id
PAYPAL_REQUEST_TIMEOUT_MS=4000

# ─── AI (Gemini) ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_MS=18000
# For a single local request with a longer deadline, use 50000; longer timeouts disable automatic retries.

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=generate-a-long-random-secret
# AUTH_GITHUB_ID=optional_for_demo_mode
# AUTH_GITHUB_SECRET=optional_for_demo_mode
AUTH_URL=http://localhost:3000

# ─── Private Evidence Storage ──────────────────────────────
# Create this bucket in Supabase Storage and keep it private.
# Allow your local and deployed app origins in the Storage CORS settings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
SUPABASE_STORAGE_BUCKET=evidence

# ─── Analytics ────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── WhatsApp Support ────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_PHONE=9294514754
