# ─── MicroSplit AI – Environment Variables ─────────────────
# Copy this file to .env.local and fill in your real keys

# ─── Claude AI (Anthropic) ──────────────────────────────────
# Required for AI Chat Assistant (server-side only, never exposed to browser)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── WhatsApp Integration ────────────────────────────────────
# Optional custom WhatsApp support phone number (e.g. 91XXXXXXXXXX)
# If omitted, inquiries are directed dynamically to the visitor's typed phone number
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_PHONE=

# ─── Database (PostgreSQL / Prisma) ─────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/microsplit

# ─── PayPal Sandbox / Payouts ───────────────────────────────
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_webhook_id

# ─── App Configuration ─────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://microsplit-ai-five.vercel.app
NEXTAUTH_SECRET=change-me-to-a-random-secret
NEXTAUTH_URL=https://microsplit-ai-five.vercel.app

# ─── Google Analytics (Optional) ───────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
