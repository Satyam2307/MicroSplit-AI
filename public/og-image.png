<svg width="1200" height="630" viewBox="0 0 1200 630" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#07172B" />
      <stop offset="60%" stop-color="#0B1F3A" />
      <stop offset="100%" stop-color="#102C4D" />
    </linearGradient>
    <linearGradient id="tealGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0F9D8A" />
      <stop offset="100%" stop-color="#087F73" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="60" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bg)" />

  <!-- Background Ambient Glow -->
  <circle cx="1050" cy="150" r="240" fill="#0F9D8A" opacity="0.15" filter="url(#glow)" />
  <circle cx="150" cy="500" r="200" fill="#38BDF8" opacity="0.10" filter="url(#glow)" />

  <!-- Brand Header -->
  <g transform="translate(80, 70)">
    <rect width="52" height="52" rx="14" fill="#0F9D8A" />
    <!-- Lightning Icon -->
    <path d="M29 11L13 29H25L23 41L39 23H27L29 11Z" fill="#07172B" stroke="#07172B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <text x="68" y="36" fill="#FFFFFF" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif" font-weight="900" font-size="28" letter-spacing="-0.5">
      MicroSplit <tspan fill="#0F9D8A">AI</tspan>
    </text>
    <text x="68" y="52" fill="#94A3B8" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif" font-weight="500" font-size="13" letter-spacing="0.5">
      AUTONOMOUS REVENUE ATTRIBUTION &amp; SETTLEMENTS
    </text>
  </g>

  <!-- Pill Tag -->
  <g transform="translate(80, 180)">
    <rect width="480" height="36" rx="18" fill="#0F9D8A" fill-opacity="0.15" stroke="#0F9D8A" stroke-opacity="0.3" />
    <circle cx="20" cy="18" r="4" fill="#0F9D8A" />
    <text x="32" y="23" fill="#DDF7F3" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif" font-weight="600" font-size="14">
      Proof-of-Focus • Deterministic Ledger • PayPal Batch
    </text>
  </g>

  <!-- Main Headline -->
  <g transform="translate(80, 250)">
    <text x="0" y="55" fill="#FFFFFF" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif" font-weight="900" font-size="54" letter-spacing="-1.5">
      Split squad revenue,
    </text>
    <text x="0" y="120" fill="#FFFFFF" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif" font-weight="900" font-size="54" letter-spacing="-1.5">
      with <tspan fill="#0F9D8A">better judgment.</tspan>
    </text>
    <text x="0" y="175" fill="#CBD5E1" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif" font-weight="400" font-size="22">
      Attribution signals converted into transparent, dispute-free disbursements
    </text>
    <text x="0" y="205" fill="#CBD5E1" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif" font-weight="400" font-size="22">
      across INR (₹), USD ($), EUR (€), and global currencies.
    </text>
  </g>

  <!-- Divider Line -->
  <line x1="80" y1="520" x2="1120" y2="520" stroke="#FFFFFF" stroke-opacity="0.12" stroke-width="1" />

  <!-- Footer Badges -->
  <g transform="translate(80, 560)">
    <text x="0" y="0" fill="#94A3B8" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif" font-weight="500" font-size="15">
      🔒 Double-Entry SHA-256 Ledger    •    ⚡ Instant PayPal Batch Payouts    •    🌐 Global IST / UTC / EST Support
    </text>
    <text x="1040" y="0" text-anchor="end" fill="#0F9D8A" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, sans-serif" font-weight="700" font-size="17">
      https://microsplit.ai
    </text>
  </g>
</svg>
